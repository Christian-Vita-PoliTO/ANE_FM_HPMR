@article{Mascolinoflattop,
   abstract = {In this paper, we analyze the performance of RAPID's time-dependent (tRAPID) algorithm that is developed based on the Transient FM (TFM) methodology. For this study, the Flattop-Pu ICSBEP benchmark is used. The kinetic parameter α Rossi is calculated with tRAPID and compared with the experimental benchmark, Serpent calculations, and with a recent publication using MCNP. Additionally, the steady-state distribution of prompt and delayed neutrons and the time-evolution of the prompt fission source due to a neutron pulse are compared with a Serpent Monte Carlo calculation.},
   author = {Valerio Mascolino and Alireza Haghighat},
   keywords = {MRT methodology,Transient Fission Matrix,benchmark,tRAPID,time-dependent},
   title = {VALIDATION OF THE TRANSIENT FISSION MATRIX CODE TRAPID AGAINST THE FLATTOP-PU BENCHMARK},
}

